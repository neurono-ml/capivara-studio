        "id": "slide-02",
        "scene_type": "chart",
        "output_format": "png",
        "resolution": [1080, 1350],
        "duration": 3,
        "platform": "ig_carousel",
        "brand": "/work/brand/brand.local.json",
        "params": {
          "kind": "bar",
          "labels": ["Sem cache", "Com cache"],
          "values": [48, 6],
          "accent_bar": 1,
          "animate_count": true,
          "show_axis": true
        }
