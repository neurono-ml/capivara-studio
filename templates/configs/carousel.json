        "resolution": [1080, 1350],
        "duration": 3,
        "platform": "ig_carousel",
        "brand": "/work/brand/brand.local.json",
        "params": {
          "code": "cache:\n  paths:\n    - target/\nkey:\n  files:\n    - Cargo.lock",
